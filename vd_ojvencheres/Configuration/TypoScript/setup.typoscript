          additionalGetParameters.tx_vdojvencheres_sale {
            action = show
            controller = Sale
          }
          fieldToParameterMap.uid = tx_vdojvencheres_sale[sale]
          pageId = 1062981
        }
      }
      provider = Vd\VdOjvencheres\XmlSitemap\SitemapDataProvider
    }
  }
  tx_vdojvencheres {
    settings {
      item {
        alertPid = 1062959
        allPid = 1011279
        detailPid = 1062979
      }
      sale.detailPid = 1062981
