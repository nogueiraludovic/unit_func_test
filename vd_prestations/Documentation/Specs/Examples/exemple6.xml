        <prestation>
            <idMetierPrestation>854PL2-RM917N</idMetierPrestation>
            <titre>Annoncer et enregistrer le changement de détenteur
                d'un arme
            </titre>
            <description>Vous ali&amp;eacute;nez (vendez, donnez, ou
                c&amp;eacute;dez) une arme ou un
                &amp;eacute;l&amp;eacute;ment essentiel d'arme
                &amp;agrave; un nouveau d&amp;eacute;tenteur. Vous devez
                l'annoncer &lt;strong>dans les 30 jours suivant la
                conclusion du contrat&lt;/strong> au Bureau des armes.
            </description>
            <domaineMetier>Sécurité</domaineMetier>
            <themeMetier>Police</themeMetier>
            <publicsCible>
                <population>Particuliers</population>
            </publicsCible>
            <emolument xmlns:xs="http://www.w3.org/2001/XMLSchema"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:type="xs:string">&lt;div class=&quot;row
                ng-scope&quot;> &lt;p>Gratuit - compris dans
                l'&amp;eacute;moluement de d&amp;eacute;livrance du
                permis d'acquisition d'armes.&lt;/p> &lt;/div>
            </emolument>
            <conditionsPrealables
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:type="xs:string">&lt;div class=&quot;row
                ng-scope&quot;> &lt;p>Toute personne qui
                ali&amp;egrave;ne (c&amp;egrave;de/vend) une arme ou un
                &amp;eacute;l&amp;eacute;ment essentiel d'arme doit,
                &lt;strong>dans les 30 jours&lt;/strong> qui suivent la
                conclusion du contrat, fournir une copie du permis
                d'acquisition d'armes/contrat de l'acqu&amp;eacute;reur
                au Bureau des armes de la Police cantonale
                vaudoise.&lt;/p> &lt;/div>
            </conditionsPrealables>
