<evenementsPublication reset="false" xmlns="http://evd.vd.ch/xmlns/eVD-0038/2">
    <evenement type="AJOUT">
        <prestation>
            <idMetierPrestation>3C6N35-HPQEEV</idMetierPrestation>
            <titre>Demander l'autorisation d'engager un agent de sécurité</titre>
            <description>&lt;div class=&quot;description col-md-9
                ng-binding&quot;> &lt;p>Vous &amp;ecirc;tes une
                entreprise de s&amp;eacute;curit&amp;eacute;, un
                &amp;eacute;tablissement ou un commerce ? Vous souhaitez
                employer, sous contrat de travail, une personne en
                qualit&amp;eacute; d'agent de
                s&amp;eacute;curit&amp;eacute; ?&lt;/p> &lt;p>Au
                pr&amp;eacute;alable, vous avez l'obligation d'obtenir
                une autorisation &amp;agrave; cet effet (carte
                concordataire).&lt;/p> &lt;p>L'autorisation est valable
                quatre ans et renouvelable sur demande.&lt;/p> &lt;/div>
            </description>
            <domaineMetier>Sécurité</domaineMetier>
            <themeMetier>Police</themeMetier>
            <publicsCible>
                <population>Entreprises</population>
            </publicsCible>
            <emolument xmlns:xs="http://www.w3.org/2001/XMLSchema"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:type="xs:string">300.- par agent
            </emolument>
            <conditionsPrealables
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:type="xs:string">&lt;p>L'autorisation d'engager du
                personnel n'est accord&amp;eacute;e que si l'agent de
                s&amp;eacute;curit&amp;eacute; :&lt;/p> &lt;p>a. est de
                nationalit&amp;eacute; suisse, ressortissant d'un État
                membre de l'Union europ&amp;eacute;enne ou de
                l'Association europ&amp;eacute;enne de
                libre-&amp;eacute;change ou, pour les ressortissants
                d'autres États &amp;eacute;trangers, titulaire d'un
                permis d'&amp;eacute;tablissement ou d'un permis de
                s&amp;eacute;jour depuis deux ans au moins ;&lt;/p>
                &lt;p>b. a l'exercice des droits civils ;&lt;/p> &lt;p>c.
                est solvable ou ne fait pas l'objet d'actes de
                d&amp;eacute;faut de biens d&amp;eacute;finitifs ;&lt;/p>
                &lt;p>d. offre, par ses
                ant&amp;eacute;c&amp;eacute;dents, par son
                caract&amp;egrave;re et son comportement, toute garantie
                d'honorabilit&amp;eacute; concernant la sph&amp;egrave;re
                d'activit&amp;eacute; envisag&amp;eacute;e. La commission
                concordataire &amp;eacute;dicte une directive
                &amp;agrave; cet &amp;eacute;gard.&lt;/p>
            </conditionsPrealables>
            <lienAide>http://www.vd.ch/autorites/departements/dis/police-cantonale/ou-nous-trouver/</lienAide>
