TCEFORM.tt_content {
  layout.types {
    highlighting-container {
      addItems {
        dark = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.dark_green
        light = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.dark_grey
      }
      disabled = 0
      label = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:background_color
      removeItems = 0,1,2,3
    }
    section-container {
      addItems {
        white = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.white
        dark = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.dark_green
        light = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.light_grey
        primary_light = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.light_green
        secondary_light = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.light_purple
        tertiary_light = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:container.layout.light_blue
      }
      disabled = 0
      label = LLL:EXT:vd_container/Resources/Private/Language/locallang_be.xlf:background_color
      removeItems = 0,1,2,3
    }
  }
  space_after_class.types {
    1-column-container.disabled = 1
    2-columns-left-width-container.disabled = 1
    2-columns-right-width-container.disabled = 1
    2-columns-same-width-container.disabled = 1
    3-columns-same-width-container.disabled = 1
    4-columns-same-width-container.disabled = 1
    accordion-container.disabled = 1
    highlighting-container.disabled = 1
    tabs-container.disabled = 1
  }
}
