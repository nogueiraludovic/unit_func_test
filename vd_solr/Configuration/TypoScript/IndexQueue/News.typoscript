plugin.tx_solr.index.queue {
  news = 1
  news {
    additionalWhereClause = pid=28405
    fields {
      abstract = teaser
      alias_intS = TEXT
      alias_intS.field = alias
      attachments.fields = related_files
      author = author
      authorEmail_stringS = author_email
      category_intM = SOLR_RELATION
      category_intM {
        foreignLabelField = uid
        localField = categories
        multiValue = 1
      }
      category_stringM = SOLR_RELATION
      category_stringM {
        localField = categories
        multiValue = 1
      }
      content = SOLR_CONTENT
      content {
        cObject = TEXT
        cObject {
          field = bodytext
          noTrimWrap = || |
        }
      }
      datetime_dateS = datetime
      keywords = SOLR_MULTIVALUE
      keywords.field = keywords
      subtype_intS = TEXT
      subtype_intS.field = type
      tags_stringM < .category_stringM
      tags_stringM.localField = tags
      title = title
      url = CASE
      url {
        default = TEXT
        default.typolink {
          additionalParams = &tx_vdnews_pi1[action]=detail&tx_vdnews_pi1[controller]=News&tx_vdnews_pi1[news]={field:uid}
          additionalParams.insertData = 1
          parameter = {$newsDefaultDetailPageUid}
          returnLast = url
          useCacheHash = 1
        }
        1 = TEXT
        1 {
          if.isTrue.field = internalurl
          typolink {
            parameter.field = internalurl
            returnLast = url
            useCacheHash = 1
          }
        }
        2 = TEXT
        2 {
          field = externalurl
          if.isTrue.field = externalurl
        }
        3 < .1
        3 {
          if.isTrue.field = aliasurl
          typolink.parameter.field = aliasurl
        }
        key.field = type
      }
    }
    table = tx_news_domain_model_news
  }
