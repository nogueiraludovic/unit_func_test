tt_content.buttons =< lib.contentElement
tt_content.buttons {
  dataProcessing {
    10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    10 {
      as = buttons
      if.isTrue.field = related_links
      orderBy = sorting
      pidInList = this
      table = tx_vdsite_domain_model_link
      where {
        data = field:uid
        intval = 1
        wrap = tx_vdsite_domain_model_link.parent=|
      }
    }
  }
  templateName = Buttons
}
