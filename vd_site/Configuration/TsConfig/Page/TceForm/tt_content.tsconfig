TCEFORM.tt_content {
  categories.types {
    biocard.disabled = 1
    buttons.disabled = 1
    cards_group.disabled = 1
    carousel.disabled = 1
    citation.disabled = 1
    links_box.disabled = 1
    menu_themes.disabled = 1
    search_form.disabled = 1
    table.disabled = 1
  }
  CType.removeItems := addToList(bullets,menu_categorized_content,menu_categorized_pages,menu_recently_updated,menu_related_pages,menu_section_pages,menu_sitemap)
  date.disabled = 1
  fe_group.types {
    biocard.disabled = 1
    buttons.disabled = 1
    cards_group.disabled = 1
    carousel.disabled = 1
    citation.disabled = 1
    links_box.disabled = 1
    menu_themes.disabled = 1
    search_form.disabled = 1
    table.disabled = 1
  }
  filelink_size.disabled = 1
  frame_class.disabled = 1
  header_layout {
    addItems.6 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.addItems.6
    altLabels {
      2 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.altLabels.2
      3 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.altLabels.3
      4 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.altLabels.4
      5 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.altLabels.5
    }
    types {
      menu_abstract.addItems {
        7 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.menu_abstract.addItems.7
        8 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.header_layout.menu_abstract.addItems.8
      }
      menu_pages < .menu_abstract
      menu_section < .menu_abstract
      menu_sitemap_pages < .menu_abstract
      menu_subpages < .menu_abstract
    }
  }
  header_position.disabled = 1
  image_zoom.disabled = 1
  imageborder.disabled = 1
  imagecols.removeItems = 3,4,5,6,7,8
  imageheight.disabled = 1
  imageorient.keepItems = 2,25,26
  imagewidth.disabled = 1
  layout {
    disabled = 1
    types {
      div {
        altLabels.1 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.div.altLabels.1
        disabled = 0
        removeItems = 2,3
      }
      cards_group {
        addItems {
          3-cols = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.cards_group.addItems.3cols
          4-cols = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.cards_group.addItems.4cols
        }
        default = 4
        disabled = 0
        removeItems = 0,1,2,3
      }
      links_box {
        addItems {
          white = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.links_box.addItems.white
          light = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.links_box.addItems.light
          primary = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.links_box.addItems.primary
          secondary = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.links_box.addItems.secondary
          tertiary = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.links_box.addItems.tertiary
        }
        default = default
        disabled = 0
        removeItems = 0,1,2,3
      }
      menu_pages {
        addItems.4 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.menu_pages.addItems.4
        disabled = 0
        removeItems = 1,2,3
      }
      menu_sitemap_pages < .menu_pages
      menu_sitemap_pages.addItems.5 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.layout.menu_sitemap_pages.addItems.5
    }
  }
  linkToTop.disabled = 1
  list_type {
    removeItems := addToList(solr_pi_frequentlysearched)
    removeItems := addToList(solr_pi_search)
    removeItems := addToList(ttaddress_listview)
    removeItems := addToList(web2pdf_pi1)
  }
  space_before_class.disabled = 1
  sys_language_uid.disabled = 1
  table_class.disabled = 1
  table_enclosure.disabled = 1
  table_header_position.addItems.3 = LLL:EXT:vd_site/Resources/Private/Language/locallang_be.xlf:tt_content.table_header_position.addItems.3
  table_tfoot.disabled = 1
  target.disabled = 1
  uploads_description.disabled = 1
  uploads_type.disabled = 1
