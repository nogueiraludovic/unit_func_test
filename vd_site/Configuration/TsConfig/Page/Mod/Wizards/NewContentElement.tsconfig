      title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:menu_menu_themes_title
      tt_content_defValues.CType = menu_themes
    }
    show := addToList(menu_themes)
  }
  forms {
    elements.search_form {
      description = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:form_search_form_description
      iconIdentifier = content-elements-searchform
      title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:form_search_form_title
      tt_content_defValues.CType = search_form
