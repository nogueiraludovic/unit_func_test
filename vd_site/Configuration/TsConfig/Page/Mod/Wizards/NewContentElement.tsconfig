        title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_biocard_title
        tt_content_defValues.CType = biocard
      }
      buttons {
        description = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_buttons_description
        iconIdentifier = content-menu-thumbnail
        title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_buttons_title
        tt_content_defValues.CType = buttons
      }
      cards_group {
        description = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_cards_group_description
        iconIdentifier = content-card-group
        title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_cards_group_title
        tt_content_defValues.CType = cards_group
      }
      carousel {
        description = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_carousel_description
        iconIdentifier = content-carousel
        title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_carousel_title
        tt_content_defValues.CType = carousel
      }
      citation {
        description = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_citation_description
        iconIdentifier = content-quote
        title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_citation_title
        tt_content_defValues.CType = citation
      }
      links_box {
        description = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_links_box_description
        iconIdentifier = content-listgroup
        title = LLL:EXT:vd_site/Resources/Private/Language/locallang_db_new_content_el.xlf:common_links_box_title
        tt_content_defValues.CType = links_box
      }
    }
    show := addToList(biocard)
    show := addToList(buttons)
    show := addToList(cards_group)
    show := addToList(carousel)
    show := addToList(citation)
    show := addToList(links_box)
