{
	"name": "vd/vd-webservice",
	"description": "Webservice for the intranet.",
	"license": "GPL-3.0-or-later",
	"type": "typo3-cms-extension",
	"version": "11.5.6",
	"authors": [
		{
			"name": "État de Vaud - DGNSI",
			"email": "support.typo3@vd.ch",
			"homepage": "https://www.vd.ch",
			"role": "Developer"
		}
	],
	"homepage": "https://portail.etat-de-vaud.ch/outils/git/projects/PEE/repos/typo3-vd-webservice",
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^11.5"
	},
	"require-dev": {
		"a9f/typo3-fractor": "^0.5",
		"ergebnis/composer-normalize": "^2.50",
		"friendsofphp/php-cs-fixer": "^3.94",
		"roave/security-advisories": "dev-latest",
		"ssch/typo3-rector": "^2.15",
		"typo3/testing-framework": "^7.1"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://elts.typo3.com",
			"canonical": false
		}
	],
	"autoload": {
		"psr-4": {
			"Vd\\VdWebservice\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Vd\\VdWebservice\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"a9f/fractor-extension-installer": true,
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "vd_webservice",
			"web-dir": ".Build/web"
		}
	},
	"scripts": {
		"check:composer:normalize": "@composer normalize --dry-run --no-check-lock",
		"check:coverage:functional": [
			"@check:tests:create-directories",
			"phpunit -c Build/phpunit/FunctionalTests.xml --coverage-text"
		],
		"check:coverage:unit": "phpunit -c Build/phpunit/UnitTests.xml --coverage-text",
		"check:php:cs-fixer": "php-cs-fixer fix --config Build/php-cs-fixer/php-cs-fixer.php --diff --dry-run",
		"check:php:fractor": "fractor process -c Build/fractor/fractor.php --dry-run",
		"check:php:rector": "rector -c Build/rector/rector.php --dry-run",
		"check:tests:create-directories": "mkdir -p htdocs/typo3temp/var/tests",
		"check:tests:functional": [
			"@check:tests:create-directories",
			"phpunit -c Build/phpunit/FunctionalTests.xml"
		],
		"check:tests:unit": "phpunit -c Build/phpunit/UnitTests.xml",
		"check:yaml:lint": "find . \\( -path './.Build' \\) -prune -o \\( -name '*.yaml' -o -name '*.yml' \\) -print0 | xargs -0 ./.Build/bin/yaml-lint",
		"fix:composer:normalize": "@composer normalize --no-check-lock",
		"fix:php:cs-fixer": "php-cs-fixer fix --config Build/php-cs-fixer/php-cs-fixer.php",
		"fix:php:fractor": "fractor process -c Build/fractor/fractor.php",
		"fix:php:rector": "rector -c Build/rector/rector.php"
	},
	"scripts-descriptions": {
		"check:composer:normalize": "Checks composer.json file content.",
		"check:coverage:functional": "Runs the functional tests with coverage report.",
		"check:coverage:unit": "Runs the unit tests with coverage report.",
		"check:php:cs-fixer": "Checks the code style with the PHP Coding Standards Fixer (PHP-CS-Fixer).",
		"check:php:fractor": "Checks for code for changes by Fractor.",
		"check:php:rector": "Checks for code for changes by Rector.",
		"check:tests:create-directories": "Creates the directories required to smoothely run the functional tests.",
		"check:tests:functional": "Runs the functional tests.",
		"check:tests:unit": "Runs the unit tests.",
		"check:yaml:lint": "Lints the YAML files.",
		"fix:composer:normalize": "Normalizes composer.json file content.",
		"fix:php:cs-fixer": "Fixes the code style with the PHP Coding Standards Fixer (PHP-CS-Fixer).",
		"fix:php:fractor": "Updates the code with Fractor.",
		"fix:php:rector": "Updates the code with Rector."
	}
}
